{
    "semi": true,
    "singleQuote": false,
    "tabWidth": 4,
    "trailingComma": "es5",
    "printWidth": 100,
    "endOfLine": "lf",
    "ignorePatterns": [
        "node_modules/**",
        "temp/**",
        "dist/**",
        "artifacts/**",
        "pnpm-lock.yaml",
        "astorb/*.txt",
        "tests/fixtures/**",
        "plans/archive/**"
    ]
}
