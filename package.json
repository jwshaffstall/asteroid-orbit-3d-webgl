{
    "name": "astorb3d",
    "version": "1.0.0",
    "private": true,
    "description": "3D WebGL visualization of 1.5 million asteroid orbits from the Lowell astorb catalog",
    "scripts": {
        "dev": "vp dev",
        "build": "vp build",
        "preview": "vp preview",
        "check": "vp check",
        "test": "vp test --project=unit --run",
        "test:e2e": "vp test --project=e2e --run",
        "screenshot": "node tools/capture-screenshot.js",
        "lint": "vp lint",
        "format": "vp fmt --write",
        "format:check": "vp fmt --check",
        "data:fetch": "node tools/fetch-catalog.mjs",
        "data:build": "node tools/astorb2bin.js -i temp/2026-10-30-astorb.dat.gz -o temp/astorb3d.bin --snapshot-date 2026-10-30",
        "data:refresh": "node tools/data-refresh.mjs",
        "data:release": "node tools/data-release.mjs",
        "data:fixture": "node tools/build-fixture.js -i temp/2026-10-30-astorb.dat.gz -o tests/fixtures/astorb-fixture.bin --snapshot-date 2026-10-30",
        "data:horizons": "node tools/horizons-fixtures.mjs",
        "generate-qr": "node tools/generate-qr.js",
        "deps:install": "pnpm install",
        "deps:update": "pnpm update",
        "deps:audit": "pnpm audit",
        "deps:audit:fix": "pnpm audit --fix"
    },
    "dependencies": {
        "gl-matrix": "^3.4.4",
        "minimist": "^1.2.8",
        "qrcode": "^1.5.4",
        "stats.js": "^0.17.0"
    },
    "devDependencies": {
        "playwright": "^1.64.0",
        "vite-plus": "1.4.0"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@12.16.1"
}
